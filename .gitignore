* {
  box-sizing: border-box;
}

:root {
  --bg: #05170d;
  --bg-soft: #0d2218;
  --panel: rgba(17, 31, 25, 0.88);
  --panel-strong: #112c1f;
  --panel-alt: #153825;
  --border: rgba(148, 245, 156, 0.22);
  --text: #ebfff0;
  --muted: rgba(224, 255, 228, 0.72);
  --primary: #97f07e;
  --primary-strong: #8ce665;
  --primary-dark: #5DBD59;
  --success: #6fe399;
  --warning: #e3ff7d;
  --shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
  --radius: 24px;
  --radius-sm: 16px;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top left, rgba(119, 220, 122, 0.18), transparent 30%),
    radial-gradient(circle at bottom right, rgba(85, 160, 90, 0.18), transparent 25%),
    var(--bg);
  color: var(--text);
}

a {
  color: inherit;
  text-decoration: none;
}

button, input, textarea {
  font: inherit;
}

img {
  max-width: 100%;
  display: block;
}

.container {
  width: min(1180px, calc(100% - 32px));
  margin: 0 auto;
}

.btn {
  border: none;
  border-radius: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-weight: 700;
  cursor: pointer;
  transition: 0.2s ease;
}

.btn:hover {
  transform: translateY(-1px);
}

.btn.small {
  padding: 12px 18px;
  font-size: 0.9rem;
}

.btn.tiny {
  padding: 8px 12px;
  font-size: 0.72rem;
}

.btn.full {
  width: 100%;
  padding: 13px 16px;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-strong));
  color: #102510;
  box-shadow: 0 14px 35px rgba(149, 233, 124, 0.35);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border);
  color: var(--text);
}

.btn-outline {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text);
}

.btn-danger {
  background: rgba(255, 92, 92, 0.12);
  border: 1px solid rgba(255, 92, 92, 0.2);
  color: #ffd4d4;
}

.app-shell, .page-shell {
  min-height: 100vh;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  backdrop-filter: blur(14px);
  background: rgba(5, 23, 13, 0.7);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.nav-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76px;
  gap: 24px;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.brand-logo {
  width: 32px;
  height: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--primary), #d3ff9f);
  color: #112b1a;
  font-weight: 900;
  box-shadow: 0 10px 26px rgba(146, 240, 126, 0.35);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 22px;
  color: var(--muted);
}

.nav-links a {
  transition: color 0.2s ease;
}

.nav-links a:hover {
  color: var(--text);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.icon-button {
  width: 42px;
  height: 42px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.02);
  color: var(--text);
  cursor: pointer;
}

.hero {
  padding: 72px 0 30px;
}

.hero-layout {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 28px;
}

.eyebrow {
  display: inline-block;
  font-size: 0.78rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--primary);
  font-weight: 700;
  margin-bottom: 18px;
}

.hero-copy h1 {
  margin: 0;
  font-size: clamp(2.8rem, 5vw, 5.2rem);
  line-height: 0.94;
  letter-spacing: -0.08em;
}

.hero-copy p {
  margin: 24px 0 28px;
  color: var(--muted);
  max-width: 600px;
  font-size: 1.05rem;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

.trust-row {
  margin-top: 22px;
}

.trust-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border-radius: 999px;
  padding: 11px 16px;
  background: rgba(151, 240, 126, 0.08);
  border: 1px solid var(--border);
  color: var(--text);
}

.hero-visual {
  position: relative;
  min-height: 540px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-visual::before {
  content: "";
  position: absolute;
  width: 420px;
  height: 420px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(140, 230, 101, 0.3), transparent 60%);
  filter: blur(35px);
}

.floating-card {
  position: absolute;
  border: 1px solid var(--border);
  border-radius: 22px;
  backdrop-filter: blur(12px);
  background: rgba(15, 33, 24, 0.75);
  box-shadow: var(--shadow);
  animation: float 5s ease-in-out infinite;
}

.feature-card {
  left: 18px;
  top: 80px;
  width: 220px;
  padding: 18px 20px;
  transform: rotate(-8deg);
}

.feature-card h4 {
  margin: 12px 0 8px;
}

.feature-card p {
  margin: 0;
  color: var(--muted);
  font-size: 0.86rem;
}

.three-dots {
  display: flex;
  gap: 8px;
}

.three-dots span {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--primary);
}

.stats-card {
  right: 30px;
  top: 15px;
  width: 190px;
  padding: 24px 20px;
  transform: rotate(8deg);
  animation-delay: 0.8s;
}

.stat-figure {
  font-size: 2rem;
  font-weight: 800;
  color: var(--primary);
}

.stat-label {
  color: var(--muted);
  margin-top: 10px;
}

.product-mini-card {
  left: 90px;
  bottom: 30px;
  width: 260px;
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 18px;
  transform: rotate(6deg);
  animation-delay: 1.4s;
}

.mini-badge {
  background: rgba(151, 240, 126, 0.18);
  color: var(--primary);
  border-radius: 10px;
  font-size: 0.72rem;
  padding: 6px 8px;
  letter-spacing: 0.08em;
}

.mini-graphic {
  width: 62px;
  height: 62px;
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(151, 240, 126, 0.85), rgba(31, 76, 53, 0.5));
}

.product-mini-card strong,
.product-mini-card small {
  display: block;
}

.product-mini-card small {
  color: var(--muted);
}

.features-band {
  padding: 30px 0 12px;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.feature-box {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 26px 20px;
}

.feature-icon {
  width: 46px;
  height: 46px;
  border-radius: 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--text);
  background: rgba(151, 240, 126, 0.12);
  border: 1px solid var(--border);
}

.feature-box h3 {
  margin: 18px 0 8px;
}

.feature-box p {
  margin: 0;
  color: var(--muted);
  line-height: 1.68;
}

.section-spacing {
  padding: 72px 0 24px;
}

.section-head {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 28px;
}

.section-head h2 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 3rem);
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
}

.product-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
}

.product-image-wrap {
  position: relative;
  height: 230px;
  overflow: hidden;
}

.product-image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-tag {
  position: absolute;
  top: 16px;
  left: 16px;
  background: rgba(12, 17, 13, 0.7);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 7px 10px;
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.product-body {
  padding: 18px 18px 20px;
}

.product-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  color: var(--muted);
  font-size: 0.82rem;
}

.stars {
  color: var(--warning);
}

.product-body h3 {
  margin: 12px 0 12px;
  font-size: 1.35rem;
}

.product-body p {
  margin: 0 0 12px;
  color: var(--muted);
  line-height: 1.7;
}

.product-body ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 8px;
}

.product-body li {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--muted);
}

.product-footer {
  margin-top: 18px;
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 12px;
}

.price-box {
  display: flex;
  flex-direction: column;
}

.price-box strong {
  font-size: 1.5rem;
}

.price-box span {
  text-decoration: line-through;
  color: rgba(255, 255, 255, 0.45);
}

.wipe-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.wipe-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 22px;
}

.wipe-head {
  display: flex;
  align-items: start;
  justify-content: space-between;
  gap: 12px;
}

.wipe-head h3 {
  margin: 10px 0 0;
  font-size: 1.6rem;
}

.wipe-status {
  margin: 0;
  color: var(--primary);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.72rem;
}

.wipe-icon {
  color: var(--primary);
  opacity: 0.9;
}

.wipe-info {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin: 18px 0;
  color: var(--muted);
  font-size: 0.88rem;
}

.wipe-prize-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-top: 18px;
}

.wipe-prize-row strong {
  font-size: 1.5rem;
}

.faq-box {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 26px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 26px;
}

.faq-copy h2 {
  margin: 0;
  font-size: clamp(2rem, 3vw, 3rem);
}

.faq-list {
  display: grid;
  gap: 14px;
}

.faq-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 16px;
  background: rgba(38, 62, 46, 0.7);
  border: 1px solid var(--border);
  border-radius: 14px;
  color: var(--text);
}

.footer {
  padding: 32px 0 60px;
}

.footer-wrap {
  display: flex;
  align-items: start;
  justify-content: space-between;
  gap: 18px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding-top: 28px;
}

.footer h3 {
  margin: 0 0 10px;
}

.footer p,
.footer-meta,
.footer-links {
  color: var(--muted);
}

.footer-links,
.footer-meta {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.detail-page {
  padding-bottom: 50px;
}

.detail-header {
  padding: 42px 0 18px;
}

.detail-head-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28px;
  align-items: center;
}

.detail-image-wrap {
  border-radius: var(--radius);
  overflow: hidden;
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
}

.detail-image-wrap img {
  width: 100%;
  height: 520px;
  object-fit: cover;
}

.detail-content h1 {
  font-size: clamp(2.2rem, 3vw, 3.8rem);
  letter-spacing: -0.05em;
  margin: 12px 0 14px;
}

.detail-content p {
  color: var(--muted);
  line-height: 1.8;
}

.detail-badges {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--border);
  background: rgba(151, 240, 126, 0.08);
  border-radius: 999px;
  padding: 8px 12px;
  font-size: 0.8rem;
}

.detail-list {
  list-style: none;
  padding: 0;
  margin: 18px 0 0;
  display: grid;
  gap: 10px;
}

.detail-list li {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--muted);
}

.detail-price-box {
  margin-top: 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: rgba(17, 44, 31, 0.9);
}

.detail-price-box strong {
  display: block;
  font-size: 2rem;
}

.detail-price-box span {
  color: rgba(255, 255, 255, 0.5);
  text-decoration: line-through;
}

.auth-shell {
  min-height: 100vh;
  display: grid;
  place-items: center;
  background:
    radial-gradient(circle at top, rgba(151, 240, 126, 0.2), transparent 35%),
    var(--bg);
}

.auth-card {
  width: min(480px, calc(100% - 28px));
  background: rgba(11, 24, 18, 0.9);
  border: 1px solid var(--border);
  border-radius: 28px;
  box-shadow: var(--shadow);
  padding: 30px 26px;
}

.auth-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  margin-bottom: 24px;
}

.auth-header h2 {
  margin: 0;
}

.auth-form {
  display: grid;
  gap: 18px;
}

.auth-form label {
  display: grid;
  gap: 8px;
  color: var(--muted);
}

.auth-form input,
.field-grid input,
.field-grid textarea,
.settings-form input,
.settings-form textarea {
  width: 100%;
  padding: 14px 16px;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: rgba(255, 255, 255, 0.02);
  color: var(--text);
}

.auth-form input::placeholder,
.field-grid input::placeholder,
.field-grid textarea::placeholder,
.settings-form input::placeholder,
.settings-form textarea::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.error-text {
  color: #ffb0b0;
  margin: 0;
}

.admin-shell {
  display: grid;
  grid-template-columns: 290px 1fr;
  min-height: 100vh;
}

.admin-sidebar {
  background: rgba(10, 22, 17, 0.94);
  border-right: 1px solid var(--border);
  padding: 24px 20px;
  display: flex;
  flex-direction: column;
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.sidebar-brand strong,
.sidebar-brand small {
  display: block;
}

.sidebar-brand small {
  color: var(--muted);
}

.admin-menu {
  display: grid;
  gap: 10px;
  margin-top: 24px;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  border-radius: 12px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  text-align: left;
}

.menu-item.active {
  background: rgba(151, 240, 126, 0.08);
  color: var(--text);
  border-color: var(--border);
}

.logout-btn {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 16px;
  border: 1px solid var(--border);
  background: rgba(255, 255, 255, 0.02);
  border-radius: 12px;
  color: var(--text);
  cursor: pointer;
}

.admin-main {
  padding: 28px;
}

.admin-panel {
  display: grid;
  gap: 24px;
}

.admin-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.admin-topbar h2 {
  margin: 0;
  font-size: clamp(2rem, 3vw, 2.6rem);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.stat-panel {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 20px;
  display: grid;
  gap: 10px;
}

.stat-panel strong {
  font-size: 1.8rem;
}

.stat-panel span {
  color: var(--muted);
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 22px;
}

.card h3 {
  margin-top: 0;
}

.activity-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 12px;
  color: var(--muted);
}

.progress-line {
  height: 12px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--border);
  overflow: hidden;
  margin: 18px 0;
}

.progress-line span {
  display: block;
  height: 100%;
  background: linear-gradient(135deg, var(--primary), #dcff92);
  border-radius: inherit;
}

.admin-grid.two-cols {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 18px;
}

.form-card {
  display: grid;
  gap: 18px;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.field-grid textarea,
.settings-form textarea {
  grid-column: 1 / -1;
  min-height: 120px;
  resize: vertical;
}

.feature-stack {
  display: grid;
  gap: 10px;
}

.mini-list {
  display: grid;
  gap: 14px;
}

.mini-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

.mini-row:last-child {
  border-bottom: none;
}

.mini-row strong,
.mini-row small {
  display: block;
}

.mini-row small {
  color: var(--muted);
}

.mini-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.settings-form {
  max-width: 900px;
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0px) rotate(var(--rot, 0deg));
  }
  50% {
    transform: translateY(-10px) rotate(var(--rot, 0deg));
  }
}

.feature-card { --rot: -8deg; }
.stats-card { --rot: 8deg; }
.product-mini-card { --rot: 6deg; }

@media (max-width: 980px) {
  .hero-layout,
  .detail-layout,
  .faq-box,
  .admin-grid.two-cols,
  .admin-shell {
    grid-template-columns: 1fr;
  }

  .products-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .wipe-grid {
    grid-template-columns: 1fr;
  }

  .admin-shell {
    display: block;
  }

  .admin-sidebar {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }
}

@media (max-width: 720px) {
  .nav-wrap,
  .section-head,
  .footer-wrap,
  .detail-head-wrap,
  .detail-price-box,
  .product-footer {
    flex-direction: column;
    align-items: flex-start;
  }

  .nav-links,
  .nav-actions {
    display: none;
  }

  .features-grid,
  .stats-grid,
  .products-grid,
  .field-grid,
  .overview-grid {
    grid-template-columns: 1fr;
  }

  .hero-copy h1 {
    font-size: 3rem;
  }

  .hero-visual {
    min-height: 420px;
  }

  .feature-card,
  .stats-card,
  .product-mini-card {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    bottom: auto;
    margin-bottom: 18px;
    transform: none;
  }

  .hero-visual {
    display: grid;
    gap: 14px;
  }
}
